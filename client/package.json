{
  "name": "toolshed-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Capstone \u2014 Kirkgate Toolshed client.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "size": "node scripts/check-bundle-size.mjs",
    "lh": "npm run build && npx --yes @lhci/cli autorun --config=./lighthouserc.json"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0",
    "react-router-dom": "^7.0.0",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@testing-library/jest-dom": "^6.6.0",
    "vitest": "^3.0.0",
    "jsdom": "^25.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "@playwright/test": "^1.49.0"
  }
}
